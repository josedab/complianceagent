# ComplianceAgent — Production Environment Configuration
# Copy to .env and fill ALL required values before deploying.
# Lines marked REQUIRED must be set; the application will refuse to start without them.
# Lines marked OPTIONAL have safe defaults and can be omitted for initial deployment.
#
# ⚠ NEVER commit real secrets. Use a secrets manager (AWS Secrets Manager, Vault, etc.).
# This file contains EXAMPLE-ONLY values that will intentionally fail fast in validators
# so they cannot be mistaken for real credentials.

# ============================
# Core Application
# ============================
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
REGISTRY=ghcr.io/josedab
VERSION=replace-with-immutable-release-tag
# REQUIRED — 64-char hex string; generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_with_python_secrets_token_hex_32
# Set to false in production to hide experimental/stub routes
ENABLE_EXPERIMENTAL=false

# ============================
# Database (PostgreSQL / Aurora)
# ============================
# REQUIRED — use TLS; sslmode=require is mandatory for production
POSTGRES_HOST=complianceagent-prod.cluster-xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_USER=complianceagent_app
POSTGRES_PASSWORD=CHANGE_ME_use_secrets_manager
POSTGRES_DB=complianceagent
POSTGRES_SSLMODE=require
# Composite URL is computed automatically by config.py — do NOT set DATABASE_URL directly.

# ============================
# Redis (ElastiCache with TLS + AUTH)
# ============================
# REQUIRED — use rediss:// (TLS) scheme in production
REDIS_HOST=complianceagent-prod.xxxxxx.0001.use1.cache.amazonaws.com
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME_use_secrets_manager
REDIS_TLS=true
# Composite REDIS_URL computed automatically — do NOT set directly.

# ============================
# Celery
# ============================
# OPTIONAL — defaults to REDIS_URL if unset
# CELERY_BROKER_URL=rediss://:CHANGE_ME@host:6379/1

# ============================
# Elasticsearch / OpenSearch
# ============================
ELASTICSEARCH_HOST=vpc-complianceagent-xxxxxxxxxxxx.us-east-1.es.amazonaws.com
ELASTICSEARCH_PORT=443
ELASTICSEARCH_USER=complianceagent
ELASTICSEARCH_PASSWORD=CHANGE_ME_use_secrets_manager
ELASTICSEARCH_USE_SSL=true

# ============================
# S3 / Object Storage (AWS)
# ============================
# REQUIRED — use real AWS S3 in production (no MinIO)
S3_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com
S3_ACCESS_KEY=use-ecs-task-role
S3_SECRET_KEY=CHANGE_ME_use_iam_role_or_secrets_manager
S3_BUCKET_REGULATIONS=complianceagent-prod-regulations
S3_BUCKET_EVIDENCE=complianceagent-prod-evidence
AVATAR_BUCKET=complianceagent-prod-evidence
S3_REGION=us-east-1

# ============================
# AWS General
# ============================
AWS_REGION=us-east-1
# Prefer IAM roles for ECS tasks over static keys
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ============================
# GitHub Copilot SDK
# ============================
# REQUIRED for AI features
COPILOT_API_KEY=CHANGE_ME_copilot_api_key
COPILOT_DEFAULT_MODEL=claude-sonnet-4-20250514
COPILOT_TIMEOUT_SECONDS=120
COPILOT_MAX_RETRIES=3

# ============================
# GitHub App Integration
# ============================
# OPTIONAL — required only if GitHub PR integration is enabled
GITHUB_APP_ID=000000
GITHUB_APP_PRIVATE_KEY=CHANGE_ME_base64_encoded_pem
GITHUB_CLIENT_ID=Iv1.0000000000000000
GITHUB_CLIENT_SECRET=CHANGE_ME_github_client_secret
GITHUB_WEBHOOK_SECRET=CHANGE_ME_github_webhook_secret

# ============================
# Stripe Billing
# ============================
# OPTIONAL — required only if billing is enabled
STRIPE_API_KEY=sk_live_CHANGE_ME_stripe_api_key
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME_stripe_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_live_CHANGE_ME_stripe_publishable_key

# ============================
# Email / SMTP
# ============================
# OPTIONAL — required for email notifications
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME_ses_smtp_user
SMTP_PASSWORD=CHANGE_ME_ses_smtp_password
SMTP_FROM_EMAIL=noreply@complianceagent.ai
SMTP_TLS=true
# Alternative: use SendGrid/Postmark API instead of SMTP
EMAIL_API_ENDPOINT=
EMAIL_API_KEY=

# ============================
# Error Tracking (Sentry)
# ============================
# OPTIONAL — strongly recommended for production
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================
# URLs and Routing
# ============================
# REQUIRED — public-facing URLs
NEXT_PUBLIC_API_URL=https://api.complianceagent.ai
NEXT_PUBLIC_APP_URL=https://app.complianceagent.ai
API_BASE_URL=https://api.complianceagent.ai
AUTH_COOKIE_DOMAIN=.complianceagent.ai

# ============================
# CORS and Allowed Hosts
# ============================
CORS_ORIGINS=["https://app.complianceagent.ai","https://complianceagent.ai"]
ALLOWED_HOSTS=["api.complianceagent.ai","app.complianceagent.ai"]

# ============================
# Proxy Trust (behind ALB/nginx)
# ============================
# Number of trusted proxy hops (ALB + nginx = 2)
FORWARDED_ALLOW_IPS=*
TRUSTED_PROXIES=2

# ============================
# Feature Flags
# ============================
FEATURE_GITHUB_APP=false
FEATURE_STRIPE_BILLING=false
FEATURE_ELASTICSEARCH=true
FEATURE_EMAIL_NOTIFICATIONS=false
FEATURE_MULTI_TENANCY=false

# ============================
# Regulatory Monitoring
# ============================
MONITORING_INTERVAL_HOURS=6
MAX_CONCURRENT_CRAWLERS=5

# ============================
# Rate Limiting
# ============================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_IN_DEBUG=false

# ============================
# Monitoring (optional)
# ============================
# DATADOG_API_KEY=CHANGE_ME_datadog_key
# DATADOG_APP_KEY=CHANGE_ME_datadog_app_key
