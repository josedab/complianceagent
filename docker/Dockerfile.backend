# =============================================================================
# Stage 1: Build locked Python dependencies
# =============================================================================
FROM python:3.12-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /usr/local/bin/uv

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1

COPY backend/pyproject.toml backend/uv.lock backend/README.md ./
RUN uv sync --frozen --no-dev --no-install-project

ENV PATH="/opt/venv/bin:$PATH"

# =============================================================================
# Stage 2: Crawler/worker with locked Playwright Chromium
# =============================================================================
FROM python:3.12-slim AS crawler

LABEL org.opencontainers.image.title="complianceagent-crawler" \
      org.opencontainers.image.description="ComplianceAgent crawler/worker with Playwright" \
      org.opencontainers.image.vendor="ComplianceAgent"

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    tini \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH=/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

RUN playwright install chromium \
    && playwright install-deps chromium \
    && chmod -R a+rX /ms-playwright

COPY backend/ .

RUN /usr/local/bin/python -m pip uninstall -y pip \
    && useradd -m -u 1000 appuser \
    && chown -R appuser:appuser /app

STOPSIGNAL SIGTERM
USER appuser

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD ["celery", "-A", "app.workers", "inspect", "ping", "--timeout", "5"]

ENTRYPOINT ["tini", "--"]
CMD ["celery", "-A", "app.workers", "worker", "--loglevel=info", "--concurrency=4"]

# =============================================================================
# Stage 3: API server
# =============================================================================
FROM python:3.12-slim AS api

LABEL org.opencontainers.image.title="complianceagent-api" \
      org.opencontainers.image.description="ComplianceAgent FastAPI backend" \
      org.opencontainers.image.vendor="ComplianceAgent"

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    tini \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH=/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY backend/ .

RUN /usr/local/bin/python -m pip uninstall -y pip \
    && useradd -m -u 1000 appuser \
    && chown -R appuser:appuser /app

STOPSIGNAL SIGTERM
USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
    CMD ["curl", "-fsS", "http://localhost:8000/health"]

ENTRYPOINT ["tini", "--"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", \
     "--proxy-headers", "--timeout-graceful-shutdown", "30"]
